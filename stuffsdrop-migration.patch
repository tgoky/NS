+    key: "wishes",
+    title: "Wishes",
+    href: "/whatstuff",
+    icon: Inbox,
+    match: ["/whatstuff"],
+  },
+  {
+    key: "mine",
+    title: "Mine",
+    href: "/my-drops",
+    icon: Package,
+    match: ["/my-drops", "/my-requests", "/wishlist", "/profile"],
+    groups: [
+      {
+        links: [
+          { title: "My drops", href: "/my-drops", icon: Package },
+          { title: "New drop", href: "/my-drops/create", icon: PackagePlus },
+          { title: "Saved", href: "/wishlist", icon: Heart },
+        ],
+      },
+      {
+        label: "Account",
+        links: [
