+                </p>
+              ) : (
+                <div className="grid grid-cols-2 gap-3">
+                  {myInventory.map((myObj) => {
+                    const isSelected = selectedOwnItem === myObj.id;
+                    return (
+                      <div
+                        key={myObj.id}
+                        onClick={() => setSelectedOwnItem(myObj.id)}
+                        className={`relative cursor-pointer group border transition-all ${
+                          isSelected
+                            ? 'border-white bg-white/5'
+                            : 'border-white/10 hover:border-white/40 bg-black'
+                        }`}
+                      >
+                        <div className="relative w-full aspect-square overflow-hidden border-b border-white/5">
+                          {myObj.imageUrl && (
+                            <Image src={myObj.imageUrl} alt={myObj.title} fill sizes="160px" className="object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
+                          )}
+                        </div>
+                        <div className="p-3">
+                          <p className="text-[9px] font-bold uppercase tracking-wide text-zinc-300 line-clamp-2 leading-snug">
+                            {myObj.title}
+                          </p>
+                        </div>
+
+                        {isSelected && (
+                          <div className="absolute top-2 right-2 bg-white text-black p-1">
+                            <Check className="w-3 h-3" strokeWidth={4} />
+                          </div>
+                        )}
+                      </div>
+                    );
+                  })}
+                </div>
+              )}
+            </div>
+
+          </div>
+        )}
+
+        <div className="p-6 border-t border-white/10 bg-black mt-auto">
+          <button
+            onClick={sendProposal}
+            disabled={!selectedOwnItem || submitting || submitted}
+            className={`w-full py-4 text-[11px] font-black uppercase tracking-[0.2em] transition-all flex items-center justify-center gap-2 ${
+              submitted
+                ? 'bg-[#00FFB2] text-black cursor-default'
+                : selectedOwnItem
+                  ? 'bg-white text-black hover:bg-zinc-300 cursor-pointer'
+                  : 'bg-zinc-900 text-zinc-600 cursor-not-allowed'
+            }`}
+          >
+            {submitted ? 'Proposal Sent ✓' : submitting ? 'Sending...' : selectedOwnItem ? 'Send Proposal' : 'Select an Item First'}
+          </button>
+        </div>
+
+      </div>
+    </div>
+  );
+}
